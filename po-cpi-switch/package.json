{
  "name": "po-cpi-switch",
  "version": "1.0.0",
  "description": "SAP PI/PO to Cloud Integration switch interface",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "build": "cd client && npm run build",
    "dev:client": "cd client && npm run dev",
    "dev:all": "concurrently \"npm run dev\" \"npm run dev:client\""
  },
  "dependencies": {
    "@xmldom/xmldom": "^0.8.10",
    "axios": "^1.6.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.1",
    "express": "^4.18.2",
    "multer": "^1.4.5-lts.1",
    "pg": "^8.23.1",
    "uuid": "^9.0.0",
    "xlsx": "^0.18.5",
    "xpath": "^0.0.34"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "nodemon": "^3.0.3"
  }
}
